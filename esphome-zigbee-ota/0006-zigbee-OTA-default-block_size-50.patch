From bdc60cb651ecb878171e2be50dfe7279f27d247c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 29 Oct 2026 19:48:48 +0000
Subject: [PATCH] [zigbee] OTA: default block_size 50

A block of 64 data bytes never reached a router behind Zigbee2MQTT (the
block response no longer fits one Zigbee frame), so asking for 223 relied
on the server capping it. 50 worked in every hardware run.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TAigdDwPTsH7gxNNraUrHU
---
 esphome/components/zigbee/ota/__init__.py        | 7 +++++--
 esphome/components/zigbee/ota/zigbee_ota_esp32.h | 2 +-
 2 files changed, 6 insertions(+), 3 deletions(-)

diff --git a/esphome/components/zigbee/ota/__init__.py b/esphome/components/zigbee/ota/__init__.py
index 0da80aa..aa2d6b6 100644
--- a/esphome/components/zigbee/ota/__init__.py
+++ b/esphome/components/zigbee/ota/__init__.py
@@ -55,8 +55,11 @@ CONFIG_SCHEMA = cv.All(
             cv.Optional(CONF_FILE_VERSION): cv.hex_uint32_t,
             # Defaults to the first endpoint.
             cv.Optional(CONF_ENDPOINT): cv.int_range(min=1, max=240),
-            # Largest block the client asks for; the server may send less.
-            cv.Optional(CONF_BLOCK_SIZE, default=223): cv.int_range(min=16, max=254),
+            # Largest block the client asks for; the server may send less. A
+            # block response carries ~17 bytes of headers on top of the data and
+            # must fit one Zigbee frame (less room on a routed or secured path):
+            # 64 data bytes never arrived on a router behind Zigbee2MQTT, 50 did.
+            cv.Optional(CONF_BLOCK_SIZE, default=50): cv.int_range(min=16, max=254),
             # zlib-compress the image in the OTA file (about 60 % of the size).
             cv.Optional(CONF_COMPRESS, default=True): cv.boolean,
             # A new image is confirmed only once the OTA server answers (Query
diff --git a/esphome/components/zigbee/ota/zigbee_ota_esp32.h b/esphome/components/zigbee/ota/zigbee_ota_esp32.h
index b3e97e4..19cbfde 100644
--- a/esphome/components/zigbee/ota/zigbee_ota_esp32.h
+++ b/esphome/components/zigbee/ota/zigbee_ota_esp32.h
@@ -64,7 +64,7 @@ class ZigbeeOTAComponent : public ota::OTAComponent, public ZigbeeOTAListener, p
 #endif
 
   uint8_t endpoint_{1};
-  uint8_t block_size_{223};
+  uint8_t block_size_{50};
   uint32_t file_version_{0};
   uint16_t manufacturer_code_{0};
   uint16_t image_type_{0};
-- 

From ba4da4c47210df0c5c275f660175a7ef2c8d816c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 29 Oct 2026 20:43:52 +0000
Subject: [PATCH] [zigbee] OTA: confirm a new image on any frame from the
 coordinator

On hardware, Zigbee2MQTT did not answer Query Next Image after a second
update within a day (its update_check_interval), so a good image was
rolled back after confirm_timeout. Any frame from the coordinator now
confirms the image too: Zigbee2MQTT re-interviews a device within
seconds of the announce that follows an update. Query Next Image stays
as a second way.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TAigdDwPTsH7gxNNraUrHU
---
 esphome/components/zigbee/ota/__init__.py     |  7 +++--
 .../zigbee/ota/zigbee_ota_esp32.cpp           | 31 +++++++++++++++++--
 .../components/zigbee/ota/zigbee_ota_esp32.h  |  9 ++++--
 3 files changed, 39 insertions(+), 8 deletions(-)

diff --git a/esphome/components/zigbee/ota/__init__.py b/esphome/components/zigbee/ota/__init__.py
index aa2d6b6..c9267f7 100644
--- a/esphome/components/zigbee/ota/__init__.py
+++ b/esphome/components/zigbee/ota/__init__.py
@@ -62,9 +62,10 @@ CONFIG_SCHEMA = cv.All(
             cv.Optional(CONF_BLOCK_SIZE, default=50): cv.int_range(min=16, max=254),
             # zlib-compress the image in the OTA file (about 60 % of the size).
             cv.Optional(CONF_COMPRESS, default=True): cv.boolean,
-            # A new image is confirmed only once the OTA server answers (Query
-            # Next Image); without an answer in this time the bootloader rolls
-            # back to the previous image. 0s leaves it to safe_mode alone.
+            # A new image is confirmed only once the coordinator is heard (any
+            # frame from it, or an answer to Query Next Image); without that in
+            # this time the bootloader rolls back to the previous image. 0s
+            # leaves it to safe_mode alone.
             cv.Optional(
                 CONF_CONFIRM_TIMEOUT, default="10min"
             ): cv.positive_time_period_milliseconds,
diff --git a/esphome/components/zigbee/ota/zigbee_ota_esp32.cpp b/esphome/components/zigbee/ota/zigbee_ota_esp32.cpp
index add3a95..606305a 100644
--- a/esphome/components/zigbee/ota/zigbee_ota_esp32.cpp
+++ b/esphome/components/zigbee/ota/zigbee_ota_esp32.cpp
@@ -7,6 +7,7 @@
 
 #include "esp_ota_ops.h"
 #include "esp_zigbee.h"
+#include "ezbee/aps.h"
 #include "ezbee/zcl/cluster/ota_upgrade.h"
 #include "miniz.h"
 
@@ -42,6 +43,23 @@ static constexpr uint8_t MAX_RESYNCS = 50;
 // While a new image waits for confirmation, ask the server this often.
 static constexpr uint32_t CONFIRM_QUERY_MS = 30000;
 
+#ifdef USE_ZIGBEE_OTA_CONFIRM
+static ZigbeeOTAComponent *pending_confirm_instance = nullptr;  // NOLINT
+
+// Any frame from the coordinator proves the new image reaches the network:
+// Zigbee2MQTT re-interviews a device right after the announce that follows an
+// update, but answers Query Next Image only once per update_check_interval (a
+// day by default), so its answer alone is not enough. On the Zigbee task;
+// never consumes the frame.
+static bool on_aps_indication(const ezb_apsde_data_ind_t *ind) {
+  if (pending_confirm_instance != nullptr && ind->status == 0 && ind->src_address.addr_mode == EZB_ADDR_MODE_SHORT &&
+      ind->src_address.u.short_addr == 0x0000) {
+    pending_confirm_instance->on_coordinator_frame();
+  }
+  return false;
+}
+#endif
+
 void ZigbeeOTAComponent::setup() {
   this->parent_->set_ota_listener(this);
 #ifdef USE_ZIGBEE_OTA_CONFIRM
@@ -52,7 +70,7 @@ void ZigbeeOTAComponent::setup() {
     this->safe_mode_->hold_app_confirmation();
     this->pending_confirm_ = true;
     this->boot_ms_ = millis();
-    ESP_LOGI(TAG, "New image, confirmed once the OTA server answers (rollback after %" PRIu32 " s)",
+    ESP_LOGI(TAG, "New image, confirmed once the coordinator is heard (rollback after %" PRIu32 " s)",
              this->confirm_timeout_ms_ / 1000);
   }
 #endif
@@ -60,6 +78,12 @@ void ZigbeeOTAComponent::setup() {
     esp_zigbee_lock_acquire(portMAX_DELAY);
     ezb_zcl_ota_upgrade_set_download_block_size(this->endpoint_, this->block_size_);
     ezb_zcl_ota_upgrade_set_download_retry(this->endpoint_, BLOCK_RETRIES, BLOCK_RETRY_MS);
+#ifdef USE_ZIGBEE_OTA_CONFIRM
+    if (this->pending_confirm_) {
+      pending_confirm_instance = this;
+      ezb_apsde_data_indication_handler_register(on_aps_indication);
+    }
+#endif
     esp_zigbee_lock_release();
   });
 }
@@ -112,10 +136,11 @@ void ZigbeeOTAComponent::loop() {
 void ZigbeeOTAComponent::confirm_loop_(uint32_t now) {
   if (this->server_answered_.load()) {
     this->pending_confirm_ = false;
-    ESP_LOGI(TAG, "OTA server answered, new image confirmed");
+    pending_confirm_instance = nullptr;
+    ESP_LOGI(TAG, "Coordinator reached, new image confirmed");
     this->safe_mode_->release_app_confirmation();
   } else if (now - this->boot_ms_ > this->confirm_timeout_ms_) {
-    ESP_LOGE(TAG, "No answer from the OTA server within %" PRIu32 " s, rolling back", this->confirm_timeout_ms_ / 1000);
+    ESP_LOGE(TAG, "Nothing from the coordinator within %" PRIu32 " s, rolling back", this->confirm_timeout_ms_ / 1000);
     App.run_safe_shutdown_hooks();
     esp_ota_mark_app_invalid_rollback_and_reboot();
   } else if (this->parent_->is_joined() &&
diff --git a/esphome/components/zigbee/ota/zigbee_ota_esp32.h b/esphome/components/zigbee/ota/zigbee_ota_esp32.h
index 19cbfde..1c1e2d4 100644
--- a/esphome/components/zigbee/ota/zigbee_ota_esp32.h
+++ b/esphome/components/zigbee/ota/zigbee_ota_esp32.h
@@ -40,6 +40,10 @@ class ZigbeeOTAComponent : public ota::OTAComponent, public ZigbeeOTAListener, p
 #endif
 
   void on_ota_action(ezb_zcl_core_action_callback_id_t callback_id, void *message) override;
+#ifdef USE_ZIGBEE_OTA_CONFIRM
+  /// A frame from the coordinator arrived (Zigbee task).
+  void on_coordinator_frame() { this->server_answered_ = true; }
+#endif
 
  protected:
   enum class ImageFormat : uint8_t { NONE, RAW, ZLIB };
@@ -69,8 +73,9 @@ class ZigbeeOTAComponent : public ota::OTAComponent, public ZigbeeOTAListener, p
   uint16_t manufacturer_code_{0};
   uint16_t image_type_{0};
 #ifdef USE_ZIGBEE_OTA_CONFIRM
-  // A new image stays unconfirmed (bootloader rollback armed) until the OTA
-  // server answers: an image that boots but cannot reach the Zigbee network
+  // A new image stays unconfirmed (bootloader rollback armed) until the
+  // coordinator is heard (any frame from it, or an answer to Query Next
+  // Image): an image that boots but cannot reach the Zigbee network
   // could not be updated again, so it rolls back after confirm_timeout_ms_.
   safe_mode::SafeModeComponent *safe_mode_{nullptr};
   uint32_t confirm_timeout_ms_{0};
